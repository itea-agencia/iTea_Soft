# Copiar a `backend/.env` y completar. Ese es el archivo que se carga de verdad:
# docker-compose lo lista en `env_file`, y fuera de Docker dotenv lo toma por defecto.
# Un `.env.development` no lo lee nadie.

NODE_ENV=production
FRONTEND_URL=https://itea-samturtravel.com

# Con la base en Docker, el puerto publicado al host es 5440 (5440 -> 5432 adentro):
#   DATABASE_URL="postgresql://postgres:<clave>@localhost:5440/samtur-development?schema=public"
# El contenedor del backend no usa esta linea: docker-compose le pasa `postgres:5432`
# por `environment`, que tiene prioridad sobre `env_file`. La de aca la usan los
# comandos que se corren desde el host, como `npx prisma db push`.
DATABASE_URL=postgresql://user:password@localhost:5440/itea_db
DIRECT_URL=postgresql://user:password@localhost:5440/itea_db

JWT_SECRET=your-secret-key-change-in-production
PORT=3000

# --- Siigo ---
#
# OJO: la sandbox y la cuenta real comparten el mismo host. Siigo no tiene una URL de
# pruebas aparte, asi que `SIIGO_BASE_URL` es identico en los dos casos y lo unico que
# separa un entorno del otro son las CREDENCIALES. Con las de produccion cargadas y el
# dry run apagado, un entorno local emite facturas reales en la cuenta de Samtur.
#
#   pruebas     usuario @siigoapi.com   (document 2372, seller 916)
#   produccion  usuario @samturtravel.com
#
# Los identificadores de documento, vendedor y formas de pago son propios de cada cuenta:
# los de una no sirven en la otra.
SIIGO_BASE_URL=https://api.siigo.com
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=iTeaSoftApp
SIIGO_DOCUMENT_ID=
SIIGO_SELLER_ID=
SIIGO_PAYMENT_TYPE_DEFAULT=
SIIGO_PAYMENT_TYPE_CREDITO=
SIIGO_IVA_TAX_ID=

# Solo el literal `false` apaga el modo de prueba: el codigo evalua
# `process.env.SIIGO_DRY_RUN !== 'false'`, asi que vacio, "0" o "no" siguen siendo prueba.
#
# En prueba se arma el payload, se guarda en `facturas_siigo` y NO se llama a Siigo: no se
# crea nada, ni borrador.
#
# Apagado, la factura si se crea en Siigo y queda en Draft, porque el payload no manda
# `stamp.send`: existe, se puede corregir o eliminar, y el timbrado ante la DIAN es manual.
# Son dos cosas distintas y conviene no confundirlas.
#
# En produccion este valor NO sale de este archivo ni de render.yaml: manda el que esta
# cargado en el dashboard de Render.
SIIGO_DRY_RUN=true

# ==========================================
# iTea Soft - Root Gitignore (Monorepo)
# ==========================================

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js
.npm/
.pnpm-store/
.yarn/cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Environment & Secret Files
# ------------------------------------------
.env
.env.*
!.env.example
*.local

# ------------------------------------------
# Build Outputs & Cache
# ------------------------------------------
dist/
dist-ssr/
build/
backend/dist/
backend/build/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/.vite/
frontend/.tsbuildinfo
.eslintcache
.stylelintcache
coverage/
.nyc_output/
*.lcov
cache/

# ------------------------------------------
# Database & Uploads
# ------------------------------------------
backend/prisma/*.db
backend/prisma/*.db-journal
backend/uploads/*
!backend/uploads/.gitkeep

# ------------------------------------------
# IDEs & System Files
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
*.tmp
pids
*.pid
*.seed
*.pid.lock

# ------------------------------------------
# Temp Folders & Scratch Files
# ------------------------------------------
logs/
scratch/
frontend-makeup/
backend-makeup/
GUIA_ERRORES_LOGIN.md
backend/test_email.js

# ------------------------------------------
# Documentos locales / borradores
# ------------------------------------------
frontend/ alcance.md
frontend/exampleBD.md
frontend/diagram_bd_ITEA.sql
frontend/diagram_dbdiagram.dbml
frontend/pdf_formato
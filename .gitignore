# ==========================================
# iTea Soft - Root Gitignore (Monorepo)
# ==========================================

# ------------------------------------------
# Dependencias y Administradores de Paquetes
# ------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.npm/
.pnpm-store/
.yarn/cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Archivos de Entorno y Secretos (NUNCA en Prod)
# ------------------------------------------
.env
.env.*
!.env.example
*.local

# ------------------------------------------
# Artefactos de Compilación y Caché
# ------------------------------------------
dist/
dist-ssr/
build/
**/dist/
**/build/
frontend/.vite/
frontend/.tsbuildinfo
.eslintcache
.stylelintcache
coverage/
.nyc_output/
*.lcov
cache/

# ------------------------------------------
# Base de Datos Local y Cargas de Archivos
# ------------------------------------------
backend/prisma/*.db
backend/prisma/*.db-journal
backend/uploads/*
!backend/uploads/.gitkeep
*.sql
*.dump
*.tar
*.bak

# ------------------------------------------
# Archivos Temporales, Scripts y Desarrollo Local
# ------------------------------------------
logs/
scratch/
frontend-makeup/
backend-makeup/
backend/sync_prod_data.js
backend/test_email.js
backend/scripts/
GUIA_ERRORES_LOGIN.md
PLAN_REFACTOR_SERVICIOS.md
PRUEBAS_REFACTOR_ROLES.md

# ------------------------------------------
# IDEs, Editores y Sistema Operativo
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
*.tmp
pids
*.pid
*.seed
*.pid.lock

# ------------------------------------------
# Documentos y Adjuntos No Requeridos
# ------------------------------------------
*.pdf
*.csv
*.xlsx
frontend/alcance.md
frontend/exampleBD.md
frontend/diagram_bd_ITEA.sql
frontend/diagram_dbdiagram.dbml
frontend/pdf_formatobackend/test*.js
*.py
backend_logs.txt
*.ps1
